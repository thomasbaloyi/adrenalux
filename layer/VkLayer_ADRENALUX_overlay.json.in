{
    "file_format_version": "1.1.2",
    "layer": {
        "name": "VK_LAYER_ADRENALUX_overlay",
        "type": "GLOBAL",
        "library_path": "@LAYER_LIBRARY_PATH@",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "AdrenaLux In-Game Overlay & Dynamic Frame Pacer Layer",
        "functions": {
            "vkNegotiateLoaderLayerInterfaceVersion": "adrenalux_NegotiateLoaderLayerInterfaceVersion"
        },
        "enable_environment": {
            "ADRENALUX_OVERLAY": "1"
        },
        "disable_environment": {
            "DISABLE_ADRENALUX_OVERLAY": "1"
        }
    }
}
